{
  "info": {
    "name": "HRIS Backend - Awanio",
    "description": "Koleksi endpoint HRIS backend.\n\nAtur variabel base_url dan token pada tab Variables. Endpoint login menyimpan token secara otomatis.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "position_id",
      "value": ""
    },
    {
      "key": "employee_id",
      "value": ""
    },
    {
      "key": "leave_request_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autentikasi",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Membuat akun lalu menerbitkan kode verifikasi enam digit.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"calon@awan.io\",\n  \"password\": \"password123\",\n  \"full_name\": \"Calon Karyawan\",\n  \"phone\": \"+628123456789\",\n  \"gender\": \"male\",\n  \"terms_accepted\": true\n}"
            }
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/verify-email",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "verify-email"
              ]
            },
            "description": "Kode berlaku 10 menit, maksimal 5 percobaan.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"calon@awan.io\",\n  \"code\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Resend Verification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/resend-verification",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "resend-verification"
              ]
            },
            "description": "Ada jeda 60 detik antar permintaan.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"calon@awan.io\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Menyimpan token ke variabel koleksi secara otomatis.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@awan.io\",\n  \"password\": \"Password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.success && b.data && b.data.token) {",
                  "  pm.collectionVariables.set('token', b.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/forgot-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "forgot-password"
              ]
            },
            "description": "Responsnya selalu sama, terdaftar maupun tidak.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@awan.io\"\n}"
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/reset-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "reset-password"
              ]
            },
            "description": "Tidak menerbitkan JWT, pengguna harus login ulang.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@awan.io\",\n  \"token\": \"<64 karakter hex dari email>\",\n  \"password\": \"passwordbaru\",\n  \"password_confirmation\": \"passwordbaru\"\n}"
            }
          }
        },
